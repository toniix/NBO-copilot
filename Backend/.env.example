# ==== LLM (obligatorio solo para generar el sales pitch) ====
# Si se deja vacío, el backend responde 200 con sales_pitch="" (el NBO no se afecta).
OPENAI_API_KEY=sk-your-key-here
# Opcional: override para proxies compatibles con OpenAI (p. ej. Azure OpenAI Service).
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT_SECONDS=30.0
# LLM_MAX_RETRIES=1

# ==== Aplicación ====
DEBUG=true

# ==== Datos ====
DATA_PATH=app/data/clientes.csv

# ==== Artefactos ML (contrato FASE 8 / propensión) ====
CHURN_MODEL_PATH=app/ml/models/churn_segmentacion.pkl
PROPENSION_MODEL_PATH=app/ml/models/modelo_propension.pkl
REBATE_CATALOG_PATH=app/ml/models/catalogo_rebate.json
CONSTANTES_PATH=app/ml/models/constantes_produccion.json
CATEGORIAS_PATH=app/ml/models/categorias_produccion.json

# ==== Catálogo de ofertas (RAG) ====
# Ruta del CSV para reconstruir el índice (ver README). El índice ya viene
# construido en app/ml/catalog_index/.
CATALOG_PATH=../ModelosML/catalogo_ofertas_entrega.csv
CATALOG_INDEX_PATH=app/ml/catalog_index
CATALOG_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CATALOG_TOP_K=5

# ==== Trazabilidad de gestiones ====
OUTCOME_STORE_PATH=app/data/outcomes.db
